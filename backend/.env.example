# ── Provider 1: KKU OpenSDK (Primary Campus Gateway) ──────────
LLM_API=your_kku_key_here
# LLM_BASE_URL=https://gen.ai.kku.ac.th/api/v1
# KKU_MODELS=gemini-3.5-flash-lite,nova-2-lite-v1,llama-4-maverick,nova-pro-v1

# ── Provider 2: Google Gemini Direct API (Cloud High-Availability) ──
# Accepts GOOGLE_API_KEY, GEMINI_API_KEY, or news_assistant
GOOGLE_API_KEY=your_google_gemini_key_here
# GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# GOOGLE_MODELS=gemini-3.5-flash-lite,gemini-3.5-flash,gemini-3.8-flash

# ── Provider 3: Thai LLM (Typhoon / Sovereign Thai Model - Disabled by default) ──
THAI_LLM_ENABLED=false
# THAI_LLM=your_typhoon_key_here
# THAI_LLM_BASE_URL=https://api.opentyphoon.ai/v1
# THAI_LLM_MODELS=typhoon-v2.5-30b-a3b-instruct

# ── High Availability Engine Tuning ──────────────────────────
# LLM_PROVIDER_ORDER=kku,google,thai_llm
# LLM_PER_TARGET_TIMEOUT=10.0
# LLM_OVERALL_REQUEST_TIMEOUT=30.0
# LLM_CIRCUIT_BREAKER_COOLDOWN=45.0
# FALLBACK_CACHE_TTL_SECONDS=7200

# Manual/local run: Playwright service exposed on localhost
PLAYWRIGHT_SERVICE_URL=http://localhost:8001/scrape
# Docker Compose run: use the internal service DNS instead
# Database settings (options: sqlite, mongodb, json) - default: sqlite (WAL mode)
DB_TYPE=sqlite
# SQLITE_FILE=news_collector.db
# SQLITE_WAL_MODE=true
# SQLITE_CACHE_SIZE_KB=64000
# NEWS_CACHE_TTL_SECONDS=30
# TRENDING_CACHE_TTL_SECONDS=60
# MONGO_URI=mongodb://localhost:27017
# MONGO_DB_NAME=news_collector

# Admin / Dev Monitoring Passcode
MONITORING_ADMIN_KEY=admin-dev-secret-2026
