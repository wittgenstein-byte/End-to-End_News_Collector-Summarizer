% กันหัวข้อค้างท้ายหน้าเมื่อตามด้วย longtable ทันที (เช่น \section ตามด้วย troubleshooting)
% longtable ตรวจว่าหัวตาราง + แถวแรกพอในหน้าหรือไม่ ถ้าไม่พอจะขึ้นหน้าใหม่ทันที
% หัวข้อที่อยู่ก่อนจึงค้างท้ายหน้าเดิม แก้แบบ 2 รอบ: รอบแรกวัดความสูงที่หัวข้อกับต้นตาราง
% ต้องใช้แล้วบันทึกลง .aux (อ้างด้วยค่า MD5 ของชื่อหัวข้อ) รอบถัดไปถ้าที่ว่างท้ายหน้า
% ไม่พอ จะย้ายหัวข้อไปหน้าใหม่ก่อน (latexmk และ Overleaf คอมไพล์ซ้ำให้เองเมื่อ .aux เปลี่ยน)
\RequirePackage{pdftexcmds}
\newcount\cskku@hdcnt     % ลำดับหัวข้อ (ใช้เป็นกุญแจสำรองถ้าไม่มี MD5)
\newcount\cskku@shipcnt   % จำนวนหน้าที่ส่งออกแล้ว ใช้ตรวจว่าตารางอยู่หน้าเดียวกับหัวข้อ
\AddToHook{shipout/before}{\global\advance\cskku@shipcnt\@ne}
\newif\ifcskku@hdmid      % หัวข้ออยู่กลางหน้า (ไม่ใช่ต้นหน้า)
\newif\ifcskku@ltnb       % longtable เริ่มทันทีหลังหัวข้อ
\let\cskku@hdkey\@empty
\def\cskku@hdstart{0pt}\def\cskku@hdbefore{0pt}\def\cskku@hdroom{0pt}\def\cskku@hdship{-1}
% ค่าจาก .aux: ถ้าชื่อหัวข้อซ้ำกันใช้ค่ามากสุด
\def\cskku@hdneed#1#2{%
  \ifcsname cskku@hdneed@#1\endcsname
    \ifdim#2>\csname cskku@hdneed@#1\endcsname\relax
      \global\@namedef{cskku@hdneed@#1}{#2}\fi
  \else \global\@namedef{cskku@hdneed@#1}{#2}\fi}
\ifdefined\pdf@mdfivesum
  \def\cskku@setkey{\ifdefined\ttl@savetitle
      \xdef\cskku@hdkey{\pdf@mdfivesum{\detokenize\expandafter{\ttl@savetitle}}}%
    \else \xdef\cskku@hdkey{n\the\cskku@hdcnt}\fi}
\else
  \def\cskku@setkey{\xdef\cskku@hdkey{n\the\cskku@hdcnt}}
\fi
% titlesec เรียก \<ชื่อหัวข้อ>break แทน \addpenalty{\@secpenalty} ก่อนพิมพ์หัวข้อ
% (\@tempskipa = ระยะก่อนหัวข้อ) ระยะเผื่อ .5\baselineskip ครอบคลุมความต่างของ
% ตำแหน่งบรรทัดแรกระหว่างต้นหน้า (\topskip) กับกลางหน้า
\def\cskku@hdbreak{%
  \global\advance\cskku@hdcnt\@ne
  \cskku@setkey
  \ifcsname cskku@hdneed@\cskku@hdkey\endcsname
    \begingroup
      \@tempdimb\csname cskku@hdneed@\cskku@hdkey\endcsname\relax
      \advance\@tempdimb\@tempskipa
      \advance\@tempdimb.5\baselineskip
      \@tempdima\pagegoal \advance\@tempdima-\pagetotal
      \ifdim\pagetotal>\z@ \ifdim\@tempdima<\@tempdimb
        \par\vfil\penalty-\@M
      \fi\fi
    \endgroup
  \fi
  \addpenalty{\@secpenalty}%
  \begingroup
    \@tempdima\pagegoal \advance\@tempdima-\pagetotal
    \xdef\cskku@hdroom{\the\@tempdima}%
  \endgroup
  \xdef\cskku@hdstart{\the\pagetotal}%
  \xdef\cskku@hdbefore{\the\dimexpr\@tempskipa\relax}%
  \xdef\cskku@hdship{\the\cskku@shipcnt}%
  \ifdim\pagetotal>\z@ \global\cskku@hdmidtrue \else \global\cskku@hdmidfalse \fi}
\let\sectionbreak\cskku@hdbreak
\let\subsectionbreak\cskku@hdbreak
\let\subsubsectionbreak\cskku@hdbreak
\let\paragraphbreak\cskku@hdbreak
\pretocmd\chapter{\global\let\cskku@hdkey\@empty}{}{}
% \if@nobreak ยังจริงตอน \begin{longtable} ถ้าไม่มีข้อความคั่นหลังหัวข้อ
% (ตรวจตอนเริ่มเพราะการพิมพ์ชื่อตาราง/แถวแรกจะล้างค่านี้ก่อนถึง \LT@start)
\AtBeginEnvironment{longtable}{%
  \if@nobreak \global\cskku@ltnbtrue
  \else \global\cskku@ltnbfalse \global\let\cskku@hdkey\@empty \fi}
% เรียกใน \LT@start: \dimen@ = ตำแหน่งในหน้า + หัวตาราง + แถวแรก
\def\cskku@ltrecord{%
  \ifcskku@ltnb \ifx\cskku@hdkey\@empty\else
    \let\cskku@ltval\relax
    \ifnum\cskku@hdship=\cskku@shipcnt
      % ตารางเริ่มในหน้าเดียวกับหัวข้อ: วัดความสูงจริง (ไม่รวมระยะก่อนหัวข้อ)
      \@tempdima\dimen@ \advance\@tempdima-\cskku@hdstart\relax
      \ifcskku@hdmid
        \advance\@tempdima-\cskku@hdbefore\relax
        \edef\cskku@ltval{\the\@tempdima}%
      \else % วัดที่ต้นหน้า: คงค่าที่วัดกลางหน้าไว้ ไม่ให้ผลสลับไปมาระหว่างรอบ
        \ifcsname cskku@hdneed@\cskku@hdkey\endcsname
          \edef\cskku@ltval{\csname cskku@hdneed@\cskku@hdkey\endcsname}%
        \else \edef\cskku@ltval{\the\@tempdima}\fi
      \fi
    \else
      % ขึ้นหน้าใหม่ระหว่างหัวข้อกับตาราง (หัวข้อค้าง หน้าใหม่ยังว่าง): ขอที่มากกว่า
      % ที่ว่างเดิมเล็กน้อย (ใน longtable \baselineskip = 0 จึงใช้ค่าคงที่)
      \ifcskku@hdmid \ifnum\numexpr\cskku@hdship+1\relax=\cskku@shipcnt
        \ifdim\pagetotal<\p@
          \@tempdima\cskku@hdroom\relax
          \advance\@tempdima-\cskku@hdbefore\relax
          \advance\@tempdima 1bp\relax
          \ifcsname cskku@hdneed@\cskku@hdkey\endcsname
            \ifdim\csname cskku@hdneed@\cskku@hdkey\endcsname>\@tempdima
              \@tempdima\csname cskku@hdneed@\cskku@hdkey\endcsname\relax
            \fi
          \fi
          \edef\cskku@ltval{\the\@tempdima}%
        \fi
      \fi\fi
    \fi
    \ifx\cskku@ltval\relax\else \ifdim\cskku@ltval<.5\textheight \if@filesw
      \immediate\write\@auxout{\string\cskku@hdneed{\cskku@hdkey}{\cskku@ltval}}%
    \fi\fi\fi
    \global\let\cskku@hdkey\@empty
  \fi\fi}
\AtBeginDocument{\if@filesw
  \immediate\write\@auxout{\string\providecommand\string\cskku@hdneed[2]{}}\fi}
\patchcmd\LT@start{\advance\dimen@ -\pagegoal}{\cskku@ltrecord\advance\dimen@ -\pagegoal}{}
  {\PackageInfo{cskkucore}{longtable patch for heading orphans not applied}}

% ตัวช่วยตาราง: หัวคอลัมน์ตัวหนา และคอลัมน์ข้อความยาว
\newcolumntype{L}[1]{>{\raggedright\arraybackslash}p{#1}}
\newcolumntype{C}[1]{>{\centering\arraybackslash}p{#1}}
\newcolumntype{Y}{>{\raggedright\arraybackslash}X}
