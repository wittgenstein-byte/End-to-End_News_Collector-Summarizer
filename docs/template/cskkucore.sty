% =====================================================================
%  cskkucore.sty  —  แกนจัดรูปแบบร่วม (Core formatting) สำหรับเอกสารโครงงาน
%  สาขาวิชาวิทยาการคอมพิวเตอร์ วิทยาลัยการคอมพิวเตอร์ มหาวิทยาลัยขอนแก่น
%
%  ใช้ร่วมกันโดย  cskkuproject.cls (เล่มรายงานโครงงาน)
%               cskkumanual.cls  (เล่มคู่มือการใช้งาน)
%
%  ทุกค่าในไฟล์นี้อ้างอิง "คู่มือการจัดทำเอกสารโครงงานคอมพิวเตอร์" (ม.ค. 2567)
%  ค่าที่คู่มือไม่ได้เขียนเป็นตัวเลข วัดจาก PDF ของคู่มือ (สร้างจาก Word)
%  หน่วย bp (big point = 1/72 นิ้ว) ใช้แทน pt เพื่อให้ขนาดตรงกับ Word
%
%  ห้ามแก้ไขไฟล์นี้ในโปรเจกต์ของนักศึกษา — แก้ที่ต้นฉบับแล้วแจกจ่ายใหม่
%
%  v2.1.0 (2026-10-20) สารบัญสมการ (\eqcaption) และ eqwhere, ขนาดฟอนต์สมการเข้ากับ
%         TH Sarabun New, สารบัญถึงหัวข้อย่อยระดับ 1 (tocdepth 2), หัวเรื่อง "(ต่อ)" และ
%         "หน้า" ในหน้าต่อของสารบัญทุกชนิด, ภาคผนวกในสารบัญแสดงเฉพาะชื่อ, \Needspace*
%  v2.1.1 (2026-10-20) รายการที่ซ้อนต่างชนิด (itemize ใน enumerate หรือกลับกัน) ไม่เยื้องซ้ำ
% =====================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{cskkucore}[2026/10/20 v2.1.1 CS KKU core formatting]

% ---------------------------------------------------------------------
% 0) ตัวเลือก (ส่งต่อมาจาก class)
% ---------------------------------------------------------------------
\newif\ifcskku@plainnum       \cskku@plainnumfalse
\newif\ifcskku@boldheadings   \cskku@boldheadingsfalse
\newif\ifcskku@chapterfloats  \cskku@chapterfloatsfalse
\newif\ifcskku@chapterpagenum \cskku@chapterpagenumfalse
\newif\ifcskku@english        \cskku@englishfalse
\newif\ifcskku@mermaid        \cskku@mermaidfalse
\newif\ifcskku@biblatex       \cskku@biblatextrue

\DeclareOption{plainnumbering}{\cskku@plainnumtrue}
\DeclareOption{boldheadings}{\cskku@boldheadingstrue}
\DeclareOption{chapterfloats}{\cskku@chapterfloatstrue}
\DeclareOption{chapterpagenumber}{\cskku@chapterpagenumtrue}
\DeclareOption{englishbook}{\cskku@englishtrue}
\DeclareOption{mermaid}{\cskku@mermaidtrue}
\DeclareOption{nobiblatex}{\cskku@biblatexfalse}
\DeclareOption*{}
\ProcessOptions\relax

% ---------------------------------------------------------------------
% 1) ต้อง compile ด้วย XeLaTeX
% ---------------------------------------------------------------------
\RequirePackage{iftex}
\ifXeTeX\else
  \PackageError{cskkucore}
    {ต้อง compile ด้วย XeLaTeX (This template requires XeLaTeX)}
    {Overleaf: Menu > Settings > Compiler > XeLaTeX}
\fi

\RequirePackage{etoolbox}
\RequirePackage{calc}
\RequirePackage{xcolor}

% ---------------------------------------------------------------------
% 2) หน้ากระดาษ — คู่มือข้อ 4: A4 ขอบบน 1.5" ซ้าย 1.5" ขวา 1" ล่าง 1"
%    เลขหน้า: มุมขวาบน baseline ห่างขอบบน 86 bp (วัดจาก PDF คู่มือ)
% ---------------------------------------------------------------------
\RequirePackage[a4paper,
  top=1.5in, bottom=1in, left=1.5in, right=1in,
  headheight=18.63bp, headsep=19.7bp, footskip=0.5in]{geometry}

% ---------------------------------------------------------------------
% 3) ฟอนต์ — คู่มือข้อ 5: TH Sarabun New ทั้งเล่ม
%    แนบ TH Sarabun New v1.3 (SIPA, GPL-2+ with font exception) ไว้ที่
%    theme/fonts/THSarabunNew-*.ttf  ลำดับการค้นหา:
%      (1) theme/fonts/THSarabunNew-Regular.ttf (ไฟล์ที่แนบมา)
%      (2) theme/fonts/Sarabun-Regular.ttf  (ชื่อไฟล์ใน template รุ่นก่อน
%          — ภายในเป็น TH Sarabun New เช่นกัน)
%      (3) TH Sarabun New ที่ติดตั้งในเครื่อง
% ---------------------------------------------------------------------
% no-math: ให้สมการใช้ฟอนต์คณิตศาสตร์ชุดเดียว (Computer Modern) ทั้งตัวแปร ตัวเลข และชื่อฟังก์ชัน
% ข้อความภาษาไทยในสมการเขียนด้วย \text{...}
\RequirePackage[no-math]{fontspec}
\newcommand*\cskkufontpath{theme/fonts/}
\def\cskku@fontname{}

\newcommand*\cskku@usefontfiles[1]{% #1 = ชื่อไฟล์ส่วนหน้า เช่น THSarabunNew
  \setmainfont{#1}[
    Path=\cskkufontpath, Extension=.ttf,
    UprightFont=*-Regular, BoldFont=*-Bold,
    ItalicFont=*-Italic,  BoldItalicFont=*-BoldItalic,
    Ligatures=TeX]%
  \setsansfont{#1}[
    Path=\cskkufontpath, Extension=.ttf,
    UprightFont=*-Regular, BoldFont=*-Bold,
    ItalicFont=*-Italic,  BoldItalicFont=*-BoldItalic,
    Ligatures=TeX]%
  \def\cskku@fontname{TH Sarabun New (\cskkufontpath #1-*.ttf)}}

\newcommand*\cskku@thaifontsetup{%
  \IfFileExists{\cskkufontpath THSarabunNew-Regular.ttf}
    {\cskku@usefontfiles{THSarabunNew}}
    {\IfFileExists{\cskkufontpath Sarabun-Regular.ttf}
       {\cskku@usefontfiles{Sarabun}}
       {\IfFontExistsTF{TH Sarabun New}
          {\setmainfont{TH Sarabun New}[Ligatures=TeX]%
           \setsansfont{TH Sarabun New}[Ligatures=TeX]%
           \def\cskku@fontname{TH Sarabun New (system)}}
          {\PackageError{cskkucore}{ไม่พบฟอนต์ TH Sarabun New}
             {คัดลอกโฟลเดอร์ theme/fonts จาก template มาไว้ในโปรเจกต์}}}}}

\ifcskku@english
  % เล่มภาษาอังกฤษทั้งเล่ม (คู่มือข้อ 5.2): Times New Roman
  % ใช้ TeX Gyre Termes (โคลน Times ที่มากับ TeX Live/Overleaf) ถ้าไม่มี Times New Roman
  \IfFontExistsTF{Times New Roman}
    {\setmainfont{Times New Roman}[Ligatures=TeX]
     \def\cskku@fontname{Times New Roman}}
    {\setmainfont{texgyretermes}[Extension=.otf,
       UprightFont=*-regular, BoldFont=*-bold,
       ItalicFont=*-italic, BoldItalicFont=*-bolditalic, Ligatures=TeX]
     \def\cskku@fontname{TeX Gyre Termes}}
  \setsansfont{texgyreheros}[Extension=.otf,
       UprightFont=*-regular, BoldFont=*-bold,
       ItalicFont=*-italic, BoldItalicFont=*-bolditalic]
\else
  \cskku@thaifontsetup
\fi

% ฟอนต์ความกว้างคงที่ (โค้ด/คำสั่ง) ที่มีอักษรไทย: TlwgMonoTH
%   = TlwgMono (TLWG, GPL + font exception) ที่แก้ให้สระ/วรรณยุกต์วางบนพยัญชนะ
%     ถูกต้องใน XeTeX (รายละเอียดใน theme/fonts/README.txt)
%   Scale=MatchLowercase ปรับให้ความสูงตัว x เท่ากับฟอนต์หลัก (ประมาณ 0.82)
\IfFileExists{\cskkufontpath TlwgMonoTH-Regular.ttf}
  {\setmonofont{TlwgMonoTH}[
     Path=\cskkufontpath, Extension=.ttf,
     UprightFont=*-Regular, BoldFont=*-Bold,
     ItalicFont=*-Oblique, BoldItalicFont=*-BoldOblique,
     Scale=MatchLowercase]}
  {\IfFontExistsTF{Tlwg Mono}
     {\setmonofont{Tlwg Mono}[Scale=MatchLowercase]%
      \PackageWarning{cskkucore}{ไม่พบ theme/fonts/TlwgMonoTH-Regular.ttf:
        ใช้ Tlwg Mono ของเครื่องแทน (สระและวรรณยุกต์ในโค้ดอาจวางผิดตำแหน่ง)}}
     {\PackageWarning{cskkucore}{ไม่พบ TlwgMonoTH: ใช้ฟอนต์ mono มาตรฐานแทน
        (อักษรไทยในโค้ดจะไม่แสดง)}}}

\AtEndPreamble{\typeout{[cskkucore] main font: \cskku@fontname}}

% ---------------------------------------------------------------------
% 4) ขนาดตัวอักษรและระยะบรรทัด — คู่มือข้อ 6
%    เนื้อหา/หัวข้อย่อย 14, หัวข้อใหญ่ 16, ชื่อบท 18 (bp = พอยต์ของ Word)
%    ระยะบรรทัด 1 เท่า (Single) ของ TH Sarabun New = 1.331 x ขนาดตัวอักษร
%    (ascent 844 + descent 457 + gap 30 ต่อ 1000) => 14 bp -> 18.63 bp
% ---------------------------------------------------------------------
\ifcskku@english
  \renewcommand\normalsize{%
    \@setfontsize\normalsize{12bp}{13.8bp}%
    \abovedisplayskip 8bp \@plus3bp \@minus4bp
    \abovedisplayshortskip \z@ \@plus3bp
    \belowdisplayshortskip 4bp \@plus3bp \@minus3bp
    \belowdisplayskip \abovedisplayskip
    \let\@listi\@listI}
  \renewcommand\small{\@setfontsize\small{11bp}{12.65bp}}
  \renewcommand\footnotesize{\@setfontsize\footnotesize{10bp}{11.5bp}}
  \renewcommand\scriptsize{\@setfontsize\scriptsize{8bp}{9.2bp}}
  \renewcommand\tiny{\@setfontsize\tiny{6bp}{6.9bp}}
  \renewcommand\large{\@setfontsize\large{14bp}{16.1bp}}
  \renewcommand\Large{\@setfontsize\Large{16bp}{18.4bp}}
  \renewcommand\LARGE{\@setfontsize\LARGE{18bp}{20.7bp}}
  \renewcommand\huge{\@setfontsize\huge{20bp}{23bp}}
  \renewcommand\Huge{\@setfontsize\Huge{22bp}{25.3bp}}
\else
  \renewcommand\normalsize{%
    \@setfontsize\normalsize{14bp}{18.63bp}%
    \abovedisplayskip 9bp \@plus3bp \@minus4bp
    \abovedisplayshortskip \z@ \@plus3bp
    \belowdisplayshortskip 5bp \@plus3bp \@minus3bp
    \belowdisplayskip \abovedisplayskip
    \let\@listi\@listI}
  \renewcommand\small{\@setfontsize\small{13bp}{17.3bp}}
  \renewcommand\footnotesize{\@setfontsize\footnotesize{12bp}{15.97bp}}
  \renewcommand\scriptsize{\@setfontsize\scriptsize{10bp}{13.31bp}}
  \renewcommand\tiny{\@setfontsize\tiny{8bp}{10.65bp}}
  \renewcommand\large{\@setfontsize\large{16bp}{21.3bp}}
  \renewcommand\Large{\@setfontsize\Large{18bp}{23.96bp}}
  \renewcommand\LARGE{\@setfontsize\LARGE{20bp}{26.62bp}}
  \renewcommand\huge{\@setfontsize\huge{24bp}{31.94bp}}
  \renewcommand\Huge{\@setfontsize\Huge{26bp}{34.6bp}}
\fi
\normalsize
\setlength\parskip{0pt}
\linespread{1}

% ขนาดฟอนต์ในสมการ: TH Sarabun New ตัวเล็กกว่าฟอนต์ละตินทั่วไปที่ขนาดเดียวกัน
% (ความสูงตัว x ประมาณ 0.79 เท่าของ Computer Modern) สมการขนาดเท่าเนื้อความจึงดูใหญ่เกิน
% ลดฟอนต์คณิตศาสตร์ทุกขนาดเหลือ 0.8 เท่า ตัวห้อย 0.7 และตัวห้อยซ้อน 0.5 ของขนาดนั้น
\ifcskku@english\else
  \newcommand*\cskku@mathsizefor[1]{%
    \begingroup #1%
      \@tempdima=.8\dimexpr\f@size\p@\relax
      \@tempdimb=.7\@tempdima
      \dimen@=.5\@tempdima
      \edef\x{\endgroup\noexpand\DeclareMathSizes{\f@size}%
        {\strip@pt\@tempdima}{\strip@pt\@tempdimb}{\strip@pt\dimen@}}%
    \x}
  \cskku@mathsizefor\tiny        \cskku@mathsizefor\scriptsize
  \cskku@mathsizefor\footnotesize \cskku@mathsizefor\small
  \cskku@mathsizefor\normalsize  \cskku@mathsizefor\large
  \cskku@mathsizefor\Large       \cskku@mathsizefor\LARGE
  \cskku@mathsizefor\huge        \cskku@mathsizefor\Huge
  \normalsize
\fi

% ขนาดเชิงความหมาย (semantic) — ใช้ชื่อเหล่านี้แทน \large ฯลฯ ในไฟล์ class
\newcommand*\cskkuChapterFont{\normalfont\Large\bfseries}   % 18 หนา
\newcommand*\cskkuSectionFont{\normalfont\large\bfseries}   % 16 หนา
\newcommand*\cskkuSubFont{%                                 % 14 ปกติ
  \normalfont\normalsize\ifcskku@boldheadings\bfseries\fi}

% ---------------------------------------------------------------------
% 5) การตัดคำภาษาไทย (XeTeX + ICU)
% ---------------------------------------------------------------------
\XeTeXlinebreaklocale "th"
\XeTeXlinebreakskip = 0pt plus 0.6pt
\XeTeXlinebreakpenalty = 0
\pretolerance=1000
\tolerance=2500
\emergencystretch=1.5em
\hbadness=3000
\clubpenalty=10000
\widowpenalty=10000
\displaywidowpenalty=10000
% ไม่ตัดหน้าทันทีหลังสมการ: คำอธิบายใต้สมการ (เช่น eqwhere) อยู่หน้าเดียวกับสมการ
\postdisplaypenalty=10000
\raggedbottom

% ---------------------------------------------------------------------
% 6) ระยะย่อหน้าตามระดับหัวข้อ — คู่มือหน้า 24–25 (วัดจาก PDF)
%    หัวข้อใหญ่ชิดซ้าย ย่อหน้าใต้หัวข้อตรงกับข้อความของหัวข้อ
%    แต่ละระดับเริ่มที่จุดย่อหน้าของระดับก่อนหน้า
% ---------------------------------------------------------------------
\newlength\cskkuIndentA   % ย่อหน้าใต้หัวข้อใหญ่ / จุดเริ่มหัวข้อย่อยระดับ 1
\newlength\cskkuIndentB   % ย่อหน้าใต้ระดับ 1   / จุดเริ่มระดับ 2
\newlength\cskkuIndentC   % ย่อหน้าใต้ระดับ 2   / จุดเริ่มระดับ 3
\newlength\cskkuIndentD   % ย่อหน้าใต้ระดับ 3
\newlength\cskkuHeadingGap % ช่องว่างขั้นต่ำหลังเลขหัวข้อ
\ifcskku@plainnum
  \setlength\cskkuIndentA{27bp}
  \setlength\cskkuIndentB{49.6bp}
  \setlength\cskkuIndentC{76.6bp}
  \setlength\cskkuIndentD{97.7bp}
\else
  % เลขแบบ บท.หัวข้อ ยาวกว่า จึงขยายระดับ 1 เล็กน้อย
  \setlength\cskkuIndentA{27bp}
  \setlength\cskkuIndentB{54bp}
  \setlength\cskkuIndentC{76.6bp}
  \setlength\cskkuIndentD{100bp}
\fi
\setlength\cskkuHeadingGap{6bp}
\ifcskku@english
  \setlength\cskkuIndentA{0.5in}
  \setlength\cskkuIndentB{0.9in}
  \setlength\cskkuIndentC{1.3in}
  \setlength\cskkuIndentD{1.7in}
\fi

\newlength\cskku@curindent
\setlength\cskku@curindent{\cskkuIndentA}
\setlength\parindent{\cskkuIndentA}
\RequirePackage{indentfirst}
% กำหนดระดับย่อหน้าปัจจุบัน (ใช้ภายใน class และในตำแหน่งพิเศษ)
\newcommand*\cskkuSetIndent[1]{%
  \global\cskku@curindent=\dimexpr#1\relax
  \global\parindent=\dimexpr#1\relax}

% กล่องเลขหัวข้อ: กว้างเท่ากับระยะถึงจุดย่อหน้าถัดไป
% ถ้าเลขยาวเกิน จะขยายออกโดยคงช่องว่างขั้นต่ำไว้
\newcommand\cskkuNumBox[2]{%
  \setbox\z@\hbox{#2}%
  \ifdim\dimexpr\wd\z@+\cskkuHeadingGap\relax>#1\relax
    \hbox{\box\z@\hskip\cskkuHeadingGap}%
  \else
    \hbox to #1{\box\z@\hfil}%
  \fi}

% ---------------------------------------------------------------------
% 7) ชื่อเรียกภาษาไทย
% ---------------------------------------------------------------------
\ifcskku@english
  \newcommand*\cskkuChapterName{Chapter}
  \newcommand*\cskkuAppendixName{Appendix}
  \newcommand*\cskkuAppendicesName{Appendices}
  \newcommand*\cskkuPageWord{Page}
  \newcommand*\cskkuContinued{(Cont.)}
  \newcommand*\cskkuReferencesName{References}
  \AtBeginDocument{%
    \renewcommand\contentsname{Contents}%
    \renewcommand\listtablename{List of Tables}%
    \renewcommand\listfigurename{List of Figures}%
    \renewcommand\figurename{Figure}%
    \renewcommand\tablename{Table}%
    \renewcommand\bibname{References}%
    \def\refname{References}%
    \renewcommand\appendixname{Appendix}%
    \renewcommand\chaptername{Chapter}}
\else
  \newcommand*\cskkuChapterName{บทที่}
  \newcommand*\cskkuAppendixName{ภาคผนวก}
  \newcommand*\cskkuAppendicesName{ภาคผนวก}
  \newcommand*\cskkuPageWord{หน้า}
  \newcommand*\cskkuContinued{(ต่อ)}
  \newcommand*\cskkuReferencesName{เอกสารอ้างอิง}
  \AtBeginDocument{%
    \renewcommand\contentsname{สารบัญ}%
    \renewcommand\listtablename{สารบัญตาราง}%
    \renewcommand\listfigurename{สารบัญภาพ}%
    \renewcommand\figurename{ภาพที่}%
    \renewcommand\tablename{ตารางที่}%
    \renewcommand\bibname{เอกสารอ้างอิง}%
    \def\refname{เอกสารอ้างอิง}%
    \renewcommand\appendixname{ภาคผนวก}%
    \renewcommand\chaptername{บทที่}}
\fi

% ---------------------------------------------------------------------
% 8) ตัวนับหน้าแบบอักษรไทย ก ข ค ... (ไม่ใช้ ฃ ฅ)
% ---------------------------------------------------------------------
\def\@thaialph#1{%
  \ifcase#1\or ก\or ข\or ค\or ง\or จ\or ฉ\or ช\or ซ\or ฌ\or ญ\or ฎ\or ฏ\or
  ฐ\or ฑ\or ฒ\or ณ\or ด\or ต\or ถ\or ท\or ธ\or น\or บ\or ป\or ผ\or ฝ\or
  พ\or ฟ\or ภ\or ม\or ย\or ร\or ล\or ว\or ศ\or ษ\or ส\or ห\or ฬ\or อ\or
  ฮ\else\@ctrerr\fi}
\def\thaialph#1{\expandafter\@thaialph\csname c@#1\endcsname}
% เข้ากันได้กับ template เดิม (\ThaiAlph{0} = ก)
\newcommand*\ThaiAlph[1]{\@thaialph{\numexpr#1+1\relax}}

% ---------------------------------------------------------------------
% 9) หัวกระดาษ — เลขหน้ามุมขวาบน ไม่มีเส้น
%    หน้าแรกของบทใช้ style "plain" = ไม่มีเลขหน้า (คู่มือข้อ 10)
% ---------------------------------------------------------------------
\RequirePackage{fancyhdr}
\fancypagestyle{cskku}{%
  \fancyhf{}%
  \fancyhead[R]{\normalfont\normalsize\thepage}%
  \renewcommand\headrulewidth{0pt}%
  \renewcommand\footrulewidth{0pt}}
\fancypagestyle{plain}{%
  \fancyhf{}%
  \fancyhead[R]{\normalfont\normalsize
    \ifcskku@frontmatter\thepage\else\ifcskku@chapterpagenum\thepage\fi\fi}%
  \renewcommand\headrulewidth{0pt}%
  \renewcommand\footrulewidth{0pt}}
\pagestyle{cskku}

% ส่วนต้น / เนื้อเรื่อง / ส่วนท้าย (report.cls ไม่มีคำสั่งเหล่านี้)
\newif\ifcskku@frontmatter \cskku@frontmatterfalse
\providecommand\frontmatter{}
\providecommand\mainmatter{}
\providecommand\backmatter{}
\renewcommand\frontmatter{%
  \clearpage\cskku@frontmattertrue\pagenumbering{thaialph}}
\renewcommand\mainmatter{%
  \clearpage\cskku@frontmatterfalse\pagenumbering{arabic}%
  \cskkuSetIndent{\cskkuIndentA}}
\renewcommand\backmatter{\clearpage}

% ---------------------------------------------------------------------
% 10) หัวข้อ — คู่มือข้อ 6 และหน้า 24–25
% ---------------------------------------------------------------------
\RequirePackage[explicit]{titlesec}
\setcounter{secnumdepth}{4}

\ifcskku@plainnum
  % แบบตัวอย่างในคู่มือ: 1.  /  1.1  /  1.1.1  /  (1)
  \renewcommand\thesection{\arabic{section}.}
  \renewcommand\thesubsection{\arabic{section}.\arabic{subsection}}
  \renewcommand\thesubsubsection{\thesubsection.\arabic{subsubsection}}
  \renewcommand\theparagraph{(\arabic{paragraph})}
\else
  % แบบ บท.หัวข้อ (คู่มือข้อ 17 และเล่มนักศึกษาส่วนใหญ่): 1.1 / 1.1.1 / (1) / (1.1)
  \renewcommand\thesection{\thechapter.\arabic{section}}
  \renewcommand\thesubsection{\thesection.\arabic{subsection}}
  \renewcommand\thesubsubsection{(\arabic{subsubsection})}
  \renewcommand\theparagraph{(\arabic{subsubsection}.\arabic{paragraph})}
\fi

% ชื่อบท: "บทที่ n" บรรทัดแรก ชื่อบทบรรทัดที่สอง 18 หนา กึ่งกลาง
% หลังชื่อบทเว้น 2 บรรทัด (คู่มือหน้า 24)
\titleformat{\chapter}[display]
  {\cskkuChapterFont\centering}
  {\cskkuChapterName\ \thechapter}
  {0pt}
  {#1}
\titleformat{name=\chapter,numberless}[block]
  {\cskkuChapterFont\centering}
  {}{0pt}{#1}
\titlespacing*{\chapter}{0pt}{-25bp}{33bp}
\titlespacing*{name=\chapter,numberless}{0pt}{-25bp}{\baselineskip}

% หัวข้อใหญ่ (section): 16 หนา ชิดซ้าย เว้น 1 บรรทัดก่อนหัวข้อ
\titleformat{\section}[hang]
  {\cskkuSectionFont}
  {\cskkuNumBox{\cskkuIndentA}{\thesection}}{0pt}{#1}
\titleformat{name=\section,numberless}[hang]
  {\cskkuSectionFont}{}{0pt}{#1}
\titlespacing*{\section}{0pt}{\baselineskip}{0pt}

% หัวข้อย่อยระดับ 1 (subsection): 14 ปกติ เริ่มที่ IndentA
\titleformat{\subsection}[hang]
  {\cskkuSubFont}
  {\cskkuNumBox{\dimexpr\cskkuIndentB-\cskkuIndentA\relax}{\thesubsection}}{0pt}{#1}
\titleformat{name=\subsection,numberless}[hang]{\cskkuSubFont}{}{0pt}{#1}
\titlespacing*{\subsection}{\cskkuIndentA}{0pt}{0pt}

% หัวข้อย่อยระดับ 2 (subsubsection): 14 ปกติ เริ่มที่ IndentB
\titleformat{\subsubsection}[hang]
  {\cskkuSubFont}
  {\cskkuNumBox{\dimexpr\cskkuIndentC-\cskkuIndentB\relax}{\thesubsubsection}}{0pt}{#1}
\titleformat{name=\subsubsection,numberless}[hang]{\cskkuSubFont}{}{0pt}{#1}
\titlespacing*{\subsubsection}{\cskkuIndentB}{0pt}{0pt}

% หัวข้อย่อยระดับ 3 (paragraph): 14 ปกติ เริ่มที่ IndentC
\titleformat{\paragraph}[hang]
  {\cskkuSubFont}
  {\cskkuNumBox{\dimexpr\cskkuIndentD-\cskkuIndentC\relax}{\theparagraph}}{0pt}{#1}
\titleformat{name=\paragraph,numberless}[hang]{\cskkuSubFont}{}{0pt}{#1}
\titlespacing*{\paragraph}{\cskkuIndentC}{0pt}{0pt}

% หัวข้อระดับที่ 5 (subparagraph): คู่มือกำหนดหัวข้อย่อยไว้ 3 ระดับใต้หัวข้อใหญ่
% เนื้อหาที่ลึกกว่านี้ควรเขียนเป็นรายการ (enumerate) ถ้าใช้ \subparagraph จะได้หัวข้อไม่มีเลข
% ที่ระยะ IndentD พร้อมคำเตือนใน log
\titleformat{\subparagraph}[hang]{\cskkuSubFont}{}{0pt}{#1}
\titlespacing*{\subparagraph}{\cskkuIndentD}{0pt}{0pt}

% ย่อหน้าหลังหัวข้อแต่ละระดับให้ตรงกับข้อความของหัวข้อ
\pretocmd{\chapter}{\cskkuSetIndent{\cskkuIndentA}}{}{}
\pretocmd{\section}{\cskkuSetIndent{\cskkuIndentA}}{}{}
\pretocmd{\subsection}{\cskkuSetIndent{\cskkuIndentB}}{}{}
\pretocmd{\subsubsection}{\cskkuSetIndent{\cskkuIndentC}}{}{}
\pretocmd{\paragraph}{\cskkuSetIndent{\cskkuIndentD}}{}{}
\pretocmd{\subparagraph}{\cskkuSetIndent{\dimexpr2\cskkuIndentD-\cskkuIndentC\relax}%
  \PackageWarning{cskkucore}{หัวข้อระดับที่ 5 (\string\subparagraph) ลึกเกินที่คู่มือกำหนด
    ควรเขียนเป็นรายการ enumerate แทน}}{}{}

% ---------------------------------------------------------------------
% 11) รายการ (itemize / enumerate) เริ่มตรงกับย่อหน้าของระดับปัจจุบัน
% ---------------------------------------------------------------------
\RequirePackage{enumitem}
\setlist{nosep, topsep=0pt, partopsep=0pt, itemsep=0pt, parsep=0pt}
% รายการระดับแรกของแต่ละชนิดเริ่มตรงกับย่อหน้าของหัวข้อ แต่ถ้าซ้อนอยู่ในรายการอื่น
% (เช่น itemize ใน enumerate) ให้เริ่มตรงกับข้อความของรายการแม่ ไม่เยื้องซ้ำ
\newcommand*\cskku@listindent{\ifnum\@listdepth>\@ne\z@\else\cskku@curindent\fi}
\setlist[itemize,1]{label=\textbullet, leftmargin=*, labelindent=\cskku@listindent, labelsep=0.6em}
\setlist[itemize,2]{label=--, leftmargin=*, labelsep=0.6em}
\setlist[itemize,3]{label=\textopenbullet, leftmargin=*, labelsep=0.6em}
\setlist[enumerate,1]{label=\arabic*), leftmargin=*, labelindent=\cskku@listindent, labelsep=0.6em}
\setlist[enumerate,2]{label=\alph*), leftmargin=*, labelsep=0.6em}
\setlist[enumerate,3]{label=\roman*), leftmargin=*, labelsep=0.6em}
\setlist[description]{leftmargin=\cskku@curindent, labelindent=\cskku@curindent, font=\bfseries}
\RequirePackage{textcomp}

