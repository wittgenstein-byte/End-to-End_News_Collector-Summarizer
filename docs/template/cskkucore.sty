  \renewcommand\cftcskkueqpresnum{\equationname\ }%
  \settowidth\cftcskkueqnumwidth{\normalfont\equationname\ \cskku@widestnum\ \ }}

% \eqcaption{ชื่อ} ใส่ใน equation หรือในบรรทัดที่มีเลขของ align/gather
% amsmath วัดขนาด align 2 รอบ จึงเก็บชื่อไว้แล้วเขียนลงสารบัญตอนพิมพ์เลขสมการ (แบบเดียวกับ \label)
\let\cskku@eqcap\@empty
\newcommand\eqcaption[1]{\ifmeasuring@\else\gdef\cskku@eqcap{#1}\fi}
\newcommand*\cskku@eqcapwrite{%
  \ifx\cskku@eqcap\@empty\else
    \stepcounter{cskkueq}%
    \addcontentsline{loe}{cskkueq}{\protect\numberline{\@currentlabel}\cskku@eqcap}%
    \global\let\cskku@eqcap\@empty
  \fi}
\AtBeginDocument{%
  % equation: เลขสมการกำหนดตั้งแต่ต้นสภาพแวดล้อม เขียนตอนจบ
  \apptocmd\endmathdisplay@a{%
    \ifx\df@tag\@empty\global\let\cskku@eqcap\@empty\else\cskku@eqcapwrite\fi}{}%
    {\PackageWarning{cskkucore}{\string\eqcaption: patch equation ไม่สำเร็จ}}%
  % align, gather ฯลฯ: เขียนหลังเพิ่มเลขของแต่ละบรรทัด
  \apptocmd\make@display@tag{%
    \ifmeasuring@\else
      \if@eqnsw\cskku@eqcapwrite\else
        \iftag@\cskku@eqcapwrite\else\global\let\cskku@eqcap\@empty\fi\fi
    \fi}{}%
    {\PackageWarning{cskkucore}{\string\eqcaption: patch align ไม่สำเร็จ}}}

% คำอธิบายสัญลักษณ์ใต้สมการ
%   \begin{eqwhere}
%     \bar{x} & ค่าเฉลี่ยเลขคณิต \\
%     n       & จำนวนผู้ตอบแบบสอบถาม
%   \end{eqwhere}
% ได้ "เมื่อ  x̄  คือ  ค่าเฉลี่ยเลขคณิต" และบรรทัดถัดไปจัดแนวตรงกัน (คอลัมน์แรกเป็นโหมดคณิตศาสตร์)
\newcommand*\cskkuWhereWord{\ifcskku@english where\else เมื่อ\fi}
\newcommand*\cskkuIsWord{\ifcskku@english is\else คือ\fi}
\newenvironment{eqwhere}{%
  \par\addvspace{.25\baselineskip}%
  \renewcommand\arraystretch{1}%
  \setbox\z@\hbox{\cskkuWhereWord\hspace{.6em}}%
  \@tempdima\dimexpr\linewidth-\cskku@curindent-\wd\z@\relax
  \noindent\hspace*{\cskku@curindent}\box\z@
  \tabularx{\@tempdima}[t]{@{}>{$}l<{$}@{\hspace{.6em}\cskkuIsWord\hspace{.6em}}
    >{\raggedright\arraybackslash}X@{}}}
  {\endtabularx\par\addvspace{.25\baselineskip}}

% รายการที่ยาวเกิน 1 หน้า: หน้าถัดไปมีชื่อรายการ "(ต่อ)" และหัวคอลัมน์ "หน้า" ซ้ำ
% หลังส่งหน้าของรายการออก ลด \textheight และเพิ่ม \headsep เท่าความสูงหัวเรื่อง (ขอบล่างคงเดิม)
% แล้ววาดหัวเรื่องในที่ว่างด้านบนด้วย hook shipout/foreground (ไม่ต้องแก้ output routine)
\newif\ifcskku@listcont
\newif\ifcskku@contpage
\newbox\cskku@contbox
\newdimen\cskku@conth
\newdimen\cskku@savedtextheight
\newdimen\cskku@savedheadsep
\newcommand*\cskku@startlistcont[1]{%
  \global\setbox\cskku@contbox\vbox{%
    \hsize\textwidth \parindent\z@ \parskip\z@ \normalfont\normalsize
    {\cskkuChapterFont\centering #1~\cskkuContinued\par}%
    \vskip\baselineskip
    \hbox to\textwidth{\hfill\textbf{\cskkuPageWord}}%
    \vskip\dimexpr\baselineskip-\topskip\relax}%
  \global\cskku@conth\dimexpr\ht\cskku@contbox+\dp\cskku@contbox\relax
  \global\cskku@savedtextheight\textheight
  \global\cskku@savedheadsep\headsep
  \global\cskku@listconttrue}
\AddToHook{shipout/after}{%
  \ifcskku@listcont
    \global\cskku@contpagetrue
    \global\textheight\dimexpr\cskku@savedtextheight-\cskku@conth\relax
    \global\headsep\dimexpr\cskku@savedheadsep+\cskku@conth\relax
  \fi}
\AddToHook{shipout/foreground}{%
  \ifcskku@contpage
    \put(\strip@pt\dimexpr1in+\hoffset+\oddsidemargin\relax,
         -\strip@pt\dimexpr1in+\voffset+\topmargin+\headheight+\cskku@savedheadsep\relax)%
      {\lower\ht\cskku@contbox\copy\cskku@contbox}%
  \fi}
\newcommand*\cskku@endlistcont{%
  \clearpage
  \ifcskku@listcont
    \global\cskku@listcontfalse \global\cskku@contpagefalse
    \global\textheight\cskku@savedtextheight
    \global\headsep\cskku@savedheadsep
    \global\@colht\textheight \global\@colroom\textheight \global\vsize\textheight
  \fi}

% นับจำนวนตาราง/ภาพของการ compile ครั้งก่อน (เก็บใน .aux)
\def\cskku@prevtables{-1}
\def\cskku@prevfigures{-1}
\newcommand*\cskku@setcounts[2]{\gdef\cskku@prevtables{#1}\gdef\cskku@prevfigures{#2}}
% นับจากรายการที่เขียนลงสารบัญตาราง/ภาพจริง (ตัวนับ table/figure เริ่มใหม่ทุกบทเมื่อใช้ chapterfloats
% จึงใช้ค่าตอนจบเล่มไม่ได้) ชื่อที่ต่อจากหน้าก่อน (\captioncont) ไม่ถูกนับ
\newcount\cskku@lotcount
\newcount\cskku@lofcount
\def\cskku@lotext{lot}
\def\cskku@lofext{lof}
\newcommand*\cskku@countlistentry[1]{%
  \edef\cskku@listext{#1}%
  \ifx\cskku@listext\cskku@lotext\global\advance\cskku@lotcount\@ne\fi
  \ifx\cskku@listext\cskku@lofext\global\advance\cskku@lofcount\@ne\fi}
% ห่อ \addcontentsline หลังแพ็กเกจอื่น (hyperref) กำหนดเสร็จแล้ว
\AddToHook{begindocument/end}{%
  \let\cskku@orig@addcontentsline\addcontentsline
  \def\addcontentsline#1{\cskku@countlistentry{#1}\cskku@orig@addcontentsline{#1}}}
\AtEndDocument{%
  \if@filesw
    \immediate\write\@mainaux{%
      \string\cskku@setcounts{\the\cskku@lotcount}{\the\cskku@lofcount}}%
  \fi}
\def\cskku@preveqs{0}
\newcommand*\cskku@seteqcount[1]{\gdef\cskku@preveqs{#1}}
\AtEndDocument{%
  \if@filesw\immediate\write\@mainaux{\string\cskku@seteqcount{\the\value{cskkueq}}}\fi}
\newcommand*\cskku@ifhaslist[2]{% #1 = prev count macro, #2 = code
  \ifnum#1=0\relax\else#2\fi}

\newcommand\cskku@listheading[1]{%
  \chapter*{#1}\cskku@pageheading}

% สารบัญ: ไม่เพิ่มตัวเองลงในสารบัญ (ตามตัวอย่างคู่มือหน้า 17)
\renewcommand\tableofcontents{%
  \clearpage
  \begingroup
    \cskkuSetIndent{0pt}%
    \cskku@listheading{\contentsname}%
    \cskku@startlistcont{\contentsname}%
    % ภาคผนวกเปลี่ยน tocdepth ระหว่างอ่าน .toc: คืนค่าเดิมหลังพิมพ์สารบัญ
    % (hyperref ใช้ tocdepth กำหนดระดับ bookmark ของ PDF)
    \edef\cskku@tocdepth{\the\c@tocdepth}%
    \@starttoc{toc}%
    \setcounter{tocdepth}{\cskku@tocdepth}%
  \endgroup
  \cskku@endlistcont}
\renewcommand\listoftables{%
  \cskku@ifhaslist{\cskku@prevtables}{%
    \clearpage
    \begingroup
      \cskkuSetIndent{0pt}%
      \cskku@listheading{\listtablename}%
      \addcontentsline{toc}{chapter}{\listtablename}%
      \cskku@startlistcont{\listtablename}%
      \let\addvspace\@gobble
      \@starttoc{lot}%
    \endgroup
    \cskku@endlistcont}}
\renewcommand\listoffigures{%
  \cskku@ifhaslist{\cskku@prevfigures}{%
    \clearpage
    \begingroup
      \cskkuSetIndent{0pt}%
      \cskku@listheading{\listfigurename}%
      \addcontentsline{toc}{chapter}{\listfigurename}%
      \cskku@startlistcont{\listfigurename}%
      \let\addvspace\@gobble
      \@starttoc{lof}%
    \endgroup
    \cskku@endlistcont}}
\newcommand\listofequations{%
  \cskku@ifhaslist{\cskku@preveqs}{%
    \clearpage
    \begingroup
      \cskkuSetIndent{0pt}%
      \cskku@listheading{\listequationname}%
      \addcontentsline{toc}{chapter}{\listequationname}%
      \cskku@startlistcont{\listequationname}%
      \let\addvspace\@gobble
      \@starttoc{loe}%
    \endgroup
    \cskku@endlistcont}}
% สารบัญทั้งหมดตามลำดับคู่มือ (สารบัญสมการต่อท้ายเมื่อมีสมการที่ใช้ \eqcaption)
\newcommand\makecontents{\tableofcontents\listoftables\listoffigures\listofequations}

% หัวเรื่องส่วนต้น/ท้ายที่ไม่มีเลขบท (บทคัดย่อ, กิตติกรรมประกาศ, ฯลฯ)
\newcommand\cskkuUnnumberedChapter[2][]{%
  \chapter*{#2}%
  % หลังภาคผนวก (เช่น ประวัติผู้เขียน) ให้กลับมาชิดซ้ายในสารบัญ
  \ifcskku@inappendix
    \addtocontents{toc}{\protect\setlength\protect\cftchapindent{\z@}}%
  \fi
  \if\relax\detokenize{#1}\relax
    \addcontentsline{toc}{chapter}{#2}%
  \else
    \addcontentsline{toc}{chapter}{#1}%
  \fi
  \cskkuSetIndent{\cskkuIndentA}}

% ---------------------------------------------------------------------
% 14) ภาคผนวก — คู่มือข้อ 19
%     หน้าคั่น "ภาคผนวก" กลางหน้า แล้วแต่ละภาคผนวกเป็น ก ข ค ...
%     ใช้ \appendix แล้วตามด้วย \chapter{ชื่อภาคผนวก}
% ---------------------------------------------------------------------
\newif\ifcskku@inappendix \cskku@inappendixfalse
\newcommand\cskkuAppendixPage{%
  \clearpage
  \thispagestyle{empty}%
  \null\vfill
  \begin{center}\cskkuChapterFont\cskkuAppendicesName\end{center}%
  \vfill\null
  \addcontentsline{toc}{chapter}{\cskkuAppendicesName}%
  \clearpage}
\renewcommand\appendix{%
  \par
  \cskkuAppendixPage
  \cskku@inappendixtrue
  \setcounter{chapter}{0}%
  \setcounter{section}{0}%
  \ifcskku@english
    \renewcommand\thechapter{\Alph{chapter}}%
  \else
    \renewcommand\thechapter{\thaialph{chapter}}%
  \fi
  \renewcommand\cskkuChapterName{\cskkuAppendixName}%
  \addtocontents{toc}{%
    \protect\renewcommand\protect\cftchappresnum{\cskkuAppendixName\ }%
    \protect\setlength\protect\cftchapindent{\cskkuIndentA}}%
  \addtocontents{toc}{\protect\settowidth\protect\cftchapnumwidth
    {\protect\normalfont\cskkuAppendixName\ ก\ \ }}%
  % สารบัญแสดงเฉพาะชื่อภาคผนวก (ตามตัวอย่างคู่มือ) ไม่แสดงหัวข้อภายในภาคผนวก
  \addtocontents{toc}{\protect\setcounter{tocdepth}{\cskkuAppendixTocDepth}}}
\newcommand*\cskkuAppendixTocDepth{0}

% ---------------------------------------------------------------------
% 15) การอ้างอิง (biblatex + biber) — คู่มือ "การเขียนเอกสารอ้างอิง"
%     อ้างแบบตัวเลข [1], [1-3], [1, 3, 5] เรียงตามลำดับที่อ้าง
%     ชื่อ. (ปี). ชื่อเรื่อง. ...  ชื่อหนังสือตัวหนา  บรรทัดที่ 2 ตรงกับอักษรแรก
% ---------------------------------------------------------------------
\ifcskku@biblatex
  \RequirePackage{cskkubib}
\fi

% ---------------------------------------------------------------------
% 16) ลิงก์ในเอกสาร
%     \url พิมพ์ในโหมดคณิตศาสตร์ การตัดคำไทย (ICU) จึงไม่แทรกช่องว่างใน URL
%     ห้ามเปลี่ยน \XeTeXlinebreaklocale ใน \UrlFont: ค่าจะค้างไปทั้งเล่ม
%     ทำให้ข้อความไทยหลัง URL แรกไม่ตัดบรรทัด
% ---------------------------------------------------------------------
\RequirePackage{xurl}
\urlstyle{same}
\ifcskku@biblatex
  % xurl ตั้งให้ตัด URL ในเอกสารอ้างอิงระหว่างตัวอักษรได้ง่ายกว่าหลัง / (ค่า 100)
  % ปรับให้ตัดหลัง / . - : ก่อน และตัดระหว่างตัวอักษรเฉพาะเมื่อจำเป็น
  \setcounter{biburllcpenalty}{7000}
  \setcounter{biburlucpenalty}{8000}
  \setcounter{biburlnumpenalty}{7000}
  % คู่มือ: ตัด URL หลังเครื่องหมาย / หรือ . (หลัง : และ - ยอมได้แต่ไม่แนะนำ)
  \setcounter{biburlbreakpenalty}{100}
  \setcounter{biburlbigbreakpenalty}{400}
  % biblatex ยืดช่องไฟระหว่างตัวอักษรใน URL ได้ (0mu plus 3mu) ทำให้ URL ในบรรทัดที่จัดชิดขอบ
  % ดูเหมือนเว้นวรรคทีละตัว เช่น "h t t p s : / /" จึงปิดไว้ให้ไปยืดช่องว่างระหว่างคำแทน
  \biburlbigskip=0mu\relax
\fi
\RequirePackage[hidelinks, unicode, bookmarksnumbered, pdfencoding=auto]{hyperref}
\RequirePackage{bookmark}

% ---------------------------------------------------------------------
% 17) โค้ดโปรแกรมและคำสั่ง (listings) — อักษรไทยแสดงได้ (columns=fullflexible)
% ---------------------------------------------------------------------
\RequirePackage{listings}
% \Needspace*{ความสูง}: ถ้าพื้นที่ที่เหลือในหน้าน้อยกว่าความสูงที่กำหนด ให้ขึ้นหน้าใหม่ก่อน
% ใช้กับโค้ดหรือเนื้อหาสั้นที่ไม่ควรแยกหน้า เช่น \Needspace*{10\baselineskip} ก่อนโค้ด 9 บรรทัด
% (ใช้แบบมี * เพราะเล่มใช้ \raggedbottom; \needspace ตัวเล็กอาจตัดหน้าเร็วเกินจำเป็น)
\RequirePackage{needspace}
\definecolor{cskkuCodeBg}{HTML}{F6F8FA}
\definecolor{cskkuCodeFrame}{HTML}{D0D7DE}
\definecolor{cskkuCodeKey}{HTML}{0B3D91}
\definecolor{cskkuCodeStr}{HTML}{A31515}
\definecolor{cskkuCodeCom}{HTML}{3A7D44}
\lstdefinestyle{cskku}{
  basicstyle=\ttfamily\small,
  columns=fullflexible, keepspaces=true,
  keywordstyle=\bfseries\color{cskkuCodeKey},
  stringstyle=\color{cskkuCodeStr},
  commentstyle=\color{cskkuCodeCom},
  numbers=left, numberstyle=\scriptsize\ttfamily\color{gray}, numbersep=6bp,
  frame=single, rulecolor=\color{cskkuCodeFrame}, backgroundcolor=\color{cskkuCodeBg},
  framesep=4bp, xleftmargin=\dimexpr\cskku@curindent+14bp\relax, framexleftmargin=14bp,
  breaklines=true, breakatwhitespace=false, tabsize=4,
  showstringspaces=false, upquote=true,
  captionpos=t, aboveskip=0.5\baselineskip, belowskip=0.5\baselineskip,
  literate={--}{{-{}-}}2}
\lstset{style=cskku}
% เลขโปรแกรมนับแบบเดียวกับภาพ/ตาราง (ต่อเนื่องทั้งเล่ม หรือแยกตามบทเมื่อใช้ chapterfloats)
\ifcskku@chapterfloats\else\lstset{numberbychapter=false}\fi
% ชื่อโปรแกรมอยู่เหนือโค้ด ชิดซ้ายแบบชื่อตาราง
\captionsetup[lstlisting]{singlelinecheck=false, justification=justified}
\AtBeginDocument{\renewcommand\lstlistingname{\ifcskku@english Listing\else โปรแกรมที่\fi}}
% อักษรไทย (U+0E01–U+0E5B) ในโค้ด: ให้ listings นับเป็นตัวอักษรของ token
% (ถ้าไม่ทำ ข้อความไทยจะพิมพ์ก่อนเครื่องหมายที่อยู่หน้า เช่น "(ครั้งเดียว)" -> "ครั้งเดียว()"
%  และความเห็นภาษาไทยจะไม่ได้สีของ comment)
\newcount\cskku@lstcnt
\def\cskku@lstthaichars{%
  \cskku@lstcnt="0E01
  \loop
    \catcode\cskku@lstcnt=\active
    \lccode`\~=\cskku@lstcnt \lccode`\/=\cskku@lstcnt
    \lowercase{\def~{\lst@ProcessLetter /}}%
  \ifnum\cskku@lstcnt<"0E5B \advance\cskku@lstcnt\@ne \repeat}
\lst@AddToHook{SelectCharTable}{\cskku@lstthaichars}

% โค้ดสั้นในบรรทัด: \cskkuCode{DATABASE_URL}  \cskkuCode{node --version}
%   - พิมพ์ตามตัวอักษร (ไม่แปลง -- เป็นขีดยาว, ใช้ _ ได้โดยไม่ต้อง \_)
%   - ตัดบรรทัดได้หลัง _ / . : - @ = ? & , ; ( และก่อน \ เมื่อยาวเกินคอลัมน์ตาราง
%   - % # & { } $ ต้องเขียนเป็น \% \# \& \{ \} \$ (พิมพ์ออกมาไม่มี \)
%   - คำสั่ง LaTeX ใส่ได้ตรง ๆ เช่น \cskkuCode{\cite{key}} -> \cite{key}
\ExplSyntaxOn
\tl_new:N  \l__cskku_code_tl
\str_new:N \l__cskku_code_str
\bool_new:N \l__cskku_code_brk_bool
\str_const:Nn \c__cskku_code_break_str { _/.:-@=?&,;( }
\cs_generate_variant:Nn \str_replace_all:Nnn { NnV }
\cs_new_protected:Npn \cskku_code:n #1
  {
    \str_set:Nn \l__cskku_code_str {#1}
    \str_replace_all:NnV \l__cskku_code_str { \% } \c_percent_str
    \str_replace_all:NnV \l__cskku_code_str { \# } \c_hash_str
    \str_replace_all:NnV \l__cskku_code_str { \& } \c_ampersand_str
    \str_replace_all:NnV \l__cskku_code_str { \_ } \c_underscore_str
    \str_replace_all:NnV \l__cskku_code_str { \{ } \c_left_brace_str
    \str_replace_all:NnV \l__cskku_code_str { \} } \c_right_brace_str
    \str_replace_all:NnV \l__cskku_code_str { \$ } \c_dollar_str
    % ลบช่องว่างที่ TeX เติมหลังชื่อคำสั่ง เช่น "\cite {key}" -> "\cite{key}"
    \prg_replicate:nn { 2 }
      {
        \regex_replace_all:nnN { (\\[A-Za-z]+)\x{20}([^A-Za-z]) } { \1\2 }
          \l__cskku_code_str
      }
    \regex_replace_all:nnN { (\\[A-Za-z]+)\x{20}\Z } { \1 } \l__cskku_code_str
    \tl_clear:N \l__cskku_code_tl
    \bool_set_false:N \l__cskku_code_brk_bool
    % จุดตัดหลังอักขระ _ / . ฯลฯ ใส่ไว้หน้าอักขระถัดไป และไม่ใส่ถ้าอักขระถัดไปเป็นช่องว่าง
    % (ช่องว่างตัดบรรทัดได้อยู่แล้ว) เช่น "(user_id, is_read)" จะตัดที่ช่องว่างหลัง ","
    % ไม่ใช่กลางชื่อ is_read
    \str_map_inline:Nn \l__cskku_code_str
      {
        \str_if_eq:nnTF {##1} { ~ }
          { \bool_set_false:N \l__cskku_code_brk_bool }
          {
            \bool_lazy_or:nnT
              { \l__cskku_code_brk_bool }
              {
                \str_if_eq_p:nV {##1} \c_backslash_str
                && ! \tl_if_empty_p:N \l__cskku_code_tl
              }
              { \tl_put_right:Nn \l__cskku_code_tl { \penalty 100 \scan_stop: } }
            \str_if_in:NnTF \c__cskku_code_break_str {##1}
              { \bool_set_true:N \l__cskku_code_brk_bool }
              { \bool_set_false:N \l__cskku_code_brk_bool }
          }
        \tl_put_right:Nn \l__cskku_code_tl {##1}
      }
    \mode_leave_vertical:
    \group_begin:
      \ttfamily \tl_use:N \l__cskku_code_tl
    \group_end:
  }
\NewDocumentCommand \cskkuCode { m } { \cskku_code:n {#1} }
